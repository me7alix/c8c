% Sprites are stored as arrays of bytes.
  Each byte represents one row of 8 pixels. %
bytes smile = [
	0b01000010,
	0b01000010,
	0b00000000,
	0b00000000,
	0b10000001,
	0b01111110
]

% Multiplies v0 by v1 using repeated addition.
  The result is stored in v0.
  v1 is consumed during the operation. %
proc mult {
	while v1 > 1 {
		v0 += v0
		v1 -= 1
	}
}

% Waits for a number of time units specified in v0.
  The countdown value is stored in dt. %
proc wait_dt {
	dt = v0
	while dt != 0 {}
}

% Program execution starts here. %
proc main {
	v0 = 2
	v1 = 3
	call mult

	v7 = v0
	v8 = 13

	loop {
		v7 += 1

		cls
		draw smile v7 v8

		v0 = 10
		call wait_dt
	}
}
