% Sprites are stored as arrays of bytes.
  Each byte represents one row of 8 pixels. %
bytes smile = [
	0b01000010,
	0b01000010,
	0b00000000,
	0b00000000,
	0b10000001,
	0b01111110
]

% Multiplies v0 by v1 using repeated addition.
  The result is stored in v0.
  v1 is consumed during the operation. %
proc mult {
	v2 = v0
	while v1 > 1 {
		v0 += v2
		v1 -= 1
	}
}

% Program execution starts here. %
proc main {
	v0 = 7
	v1 = 8
	call mult

	% Aliases aren't visible outside of the scope %
	alias x = v7
	alias y = v8

	x = v0
	y = 13

	% Tests multiplication %
	if x == 56 {
		x = 1
	}

	loop {
		x += 1

		cls
		draw smile x y
		i = smile

		dt = 3
		while dt != 0 {}
	}
}
