% Sprites are stored as arrays of bytes.
  Each byte represents one row of 8 pixels. %
bytes smile = [
	0b01000010,
	0b01000010,
	0b00000000,
	0b00000000,
	0b10000001,
	0b01111110
]

bytes bullet = [
	0b11000000,
	0b11000000
]

alias blt_max = 10
bytes blt_x = arrayOf(blt_max)
bytes blt_y = arrayOf(blt_max)

% Macros are defined like this. %
macro wait(t) {
	dt = t
	while dt != 0 {}
}

macro movement(x, y) {
	if kd == 0x8 { y += 1 }
	if kd == 0x5 { y -= 1 }
	if kd == 0x9 { x += 1 }
	if kd == 0x7 { x -= 1 }
}

% Program execution starts here. %
proc main {
	% Aliases are local to their enclosing scope. %
	alias x = v7
	alias y = v8
	alias blt_cnt = v9

	blt_x[0] = 17
	blt_y[0] = 10

	blt_x[1] = 27
	blt_y[1] = 30

	blt_x[2] = 40
	blt_y[2] = 3

	x = 0
	y = 13
	blt_cnt = 3

	loop {
		movement(x, y)

		cls

		ve = 0
		while ve < blt_cnt {
			v1 = blt_y[ve]
			v2 = blt_x[ve]
			draw bullet, v1, v2
			ve += 1
		}

		draw smile, x, y

		if vf != 0 {
			x = 0
			y = 13
		}

		wait(1)
	}
}
