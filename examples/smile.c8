% Required emulator refresh rate: 60,000 Hz. %

% Sprites are stored as arrays of bytes.
  Each byte represents one row of 8 pixels. %
bytes smile = [
	0b01000010,
	0b01000010,
	0b00000000,
	0b00000000,
	0b10000001,
	0b01111110
]

bytes bullet = [
	0b11000000,
	0b11000000
]

alias blt_max = 16
bytes blt_x   = arrayOf(blt_max)
bytes blt_y   = arrayOf(blt_max)
bytes blt_dx  = arrayOf(blt_max)
bytes blt_dy  = arrayOf(blt_max)
alias blt_cnt = vd

alias pl_x = v7
alias pl_y = v8
alias cnt = va
alias sec = vc
alias scr = vb

bytes digits = arrayOf(3)

% Macros are defined like this. %
macro movement(x, y) {
	if kd == 0x8 { y += 1 }
	if kd == 0x5 { y -= 1 }
	if kd == 0x9 { x += 1 }
	if kd == 0x7 { x -= 1 }
}

proc blt_new {
	% Aliases are local to their enclosing scope. %
	alias bc = blt_cnt

	rand v0, 63
	blt_x[blt_cnt] = v0

	rand v0, 15
	blt_y[blt_cnt] = v0

	rand v0, 1
	if v0 == 0 { blt_dx[bc] = 0 }
	else { blt_dx[bc] = 2 }

	rand v0, 1
	if v0 == 0 { blt_dy[bc] = 0 }
	else { blt_dy[bc] = 2 }

	bc += 1
}

proc print_score {
	i = digits
	bcd scr

	v1 = 1
	v2 = 1
	i = char digits[0]
	drawi v1, v2, 5

	v1 += 5
	i = char digits[1]
	drawi v1, v2, 5

	v1 += 5
	i = char digits[2]
	drawi v1, v2, 5
}

proc start_new_game {
	pl_x = 0
	pl_y = 24
	cnt = 0
	sec = 0
	scr = 0
	blt_cnt = 0
	call blt_new
	call blt_new
	call blt_new
}

% Program execution starts here. %
proc main {
	call start_new_game

	loop {
		dt = 3

		movement(pl_x, pl_y)

		ve = 0
		while ve < blt_cnt {
			with {
				v1 <-> blt_x [ve] as x
				v2 <-> blt_y [ve] as y
				v3 <-> blt_dx[ve] as dx
				v4 <-> blt_dy[ve] as dy
			} {
				if   y == 0  { dy = 2 }
				elif y >= 30 { dy = 0 }
				if   x == 0  { dx = 2 }
				elif x >= 62 { dx = 0 }

				if   dx == 0 { x -= 1 }
				elif dx == 2 { x += 1 }
				if   dy == 0 { y -= 1 }
				elif dy == 2 { y += 1 }
			}

			ve += 1
		}

		cls

		ve = 0
		while ve < blt_cnt {
			v1 = blt_x[ve]
			v2 = blt_y[ve]
			draw bullet, v1, v2
			ve += 1
		}

		draw smile, pl_x, pl_y
		if vf != 0 {
			blt_cnt = 0
			dt = 85
		}

		call print_score

		if cnt >= 20 {
			sec += 1
			scr += 1
			cnt = 0
		}

		if sec >= 7 {
			call blt_new
			sec = 0
		}

		cnt += 1

		if blt_cnt == 0 {
			call start_new_game
		}

		while dt != 0 {}
	}
}
